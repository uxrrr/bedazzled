# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set the real value only in Netlify's site environment variables (Site
# settings > Environment variables) — never commit it to the repo.
# IMPORTANT: save a second copy in a password manager or with the physical
# appraisal paperwork. If this value is lost, every encrypted item and photo
# is permanently unrecoverable — there is no recovery path.
PHOTO_ENC_KEY=

# Needed only by scripts/seed.ts to write directly to the production Blobs
# store (local `netlify dev` can't read/write prod Blobs). Get these from
# `netlify env:list` / the Netlify dashboard after the site is created.
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=
