# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set the real value only in Netlify's site environment variables (Site
# settings > Environment variables) — never commit it to the repo.
# IMPORTANT: save a second copy in a password manager or with the physical
# appraisal paperwork. If this value is lost, every encrypted item and photo
# is permanently unrecoverable — there is no recovery path.
PHOTO_ENC_KEY=

# Required by every Netlify Function too (lib/stores.ts authenticates Blobs
# explicitly rather than relying on automatic context detection — see
# CLAUDE.md), not just scripts/seed.ts. Get these from `netlify env:list` /
# the Netlify dashboard after the site is created.
# NOTE: scripts/seed.ts additionally hard-codes real store names and ignores
# BLOBS_STORE_PREFIX below — never point it at anything but production.
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# Required by every Netlify Function (lib/stores.ts refuses to guess this).
# Set to "production" for the real site; set to a nonempty test prefix like
# "test-" for local `netlify dev`, Deploy Previews, and Branch deploys, in
# Netlify's env var UI (scoped to the "Functions" category, not just builds).
BLOBS_STORE_PREFIX=test-
